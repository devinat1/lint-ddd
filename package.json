{
  "name": "lint-ddd",
  "version": "1.0.3",
  "description": "Lint rules for a TypeScript ports-and-adapters codebase.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devinat1/lint-ddd.git"
  },
  "type": "module",
  "bin": {
    "lint-ddd": "dist/bin/lint-ddd.mjs"
  },
  "exports": {
    ".": "./dist/tooling/eslint.config.mjs"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "build": "node tooling/build.mjs",
    "prepare": "node tooling/build.mjs",
    "lint:verify": "node --test tooling/tests/*.test.mjs",
    "check": "npm run lint:verify && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.1",
    "eslint-config-codely": "^4.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/utils": "^8.71.1",
    "eslint": "^9.0.0",
    "eslint-config-codely": "^4.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "typescript": "^5.9.2"
  }
}
