{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["tooling/**/*.ts"],
  "exclude": ["tooling/tests/**"]
}
